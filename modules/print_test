import os
import tempfile
import subprocess
import time
from printer import imprimir_ticket, imprimir_comanda

def print_via_notepad(text):
    """Envía contenido a imprimir Thermal usando Notepad"""
    try:
        # Crear archivo temporal
        with tempfile.NamedTemporaryFile(mode='w', suffix='.txt', delete=False, encoding='utf-8') as f:
            f.write(text)
            temp_file = f.name
        
        print(f"✓ Archivo temporal creado: {temp_file}")
        
        # Abrir con Notepad
        os.startfile(temp_file)
        time.sleep(1)
        
        # Imprimir desde Notepad
        os.system(f'notepad /p "{temp_file}"')
        time.sleep(2)
        
        # Limpiar
        os.remove(temp_file)
        print("✓ Archivo enviado a imprimir")
        return True
    except Exception as e:
        print(f"✗ Error: {e}")
        return False

